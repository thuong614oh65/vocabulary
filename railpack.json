{
  "$schema": "https://schema.railpack.com",
  "provider": "java",
  "packages": {
    "python": "3.11"
  },
  "deploy": {
    "aptPackages": [
      "python3-pip",
      "python3-venv"
    ]
  },
  "steps": {
    "install-edge-tts": {
      "commands": [
        "python3 -m pip install --break-system-packages edge-tts==7.2.8"
      ]
    }
  }
}