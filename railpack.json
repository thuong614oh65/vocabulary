{
  "$schema": "https://schema.railpack.com",
  "provider": "java",

  "deploy": {
    "aptPackages": [
      "...",
      "python3",
      "python3-pip",
      "python3.11-venv"
    ]
  },

  "steps": {
    "python-audio": {
      "commands": [
        "python3 -m venv /app/venv",
        "/app/venv/bin/pip install edge-tts"
      ]
    }
  }
}