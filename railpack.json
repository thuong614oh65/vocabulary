{
  "$schema": "https://schema.railpack.com",
  "provider": "java",

  "packages": {
    "python": "3.11"
  },

  "buildAptPackages": [
    "...",
    "python3",
    "python3-pip"
  ],

  "steps": {
    "install-edge-tts": {
      "commands": [
        "python -m pip install edge-tts"
      ],
      "deployOutputs": [
        "/mise"
      ]
    }
  },

  "deploy": {
    "aptPackages": [
      "...",
      "python3",
      "python3-pip"
    ]
  }
}